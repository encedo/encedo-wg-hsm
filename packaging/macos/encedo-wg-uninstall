#!/bin/sh
# Removes everything the Encedo WG package installed. A .pkg has no
# uninstaller of its own, so this is it:
#
#   sudo /usr/local/bin/encedo-wg-uninstall
#
# The module and what is stored in it are not touched: a configuration lives
# in the HEM, not on this Mac.
set -u
if [ "$(id -u)" -ne 0 ]; then
	echo "run it with sudo: sudo $0" >&2
	exit 1
fi
launchctl bootout system/com.encedo.wg 2>/dev/null || true
rm -f  /Library/LaunchDaemons/com.encedo.wg.plist
rm -rf "/Applications/Encedo WG.app"
rm -f  /usr/local/bin/wg-hem /usr/local/bin/wg-quick-encedo
rm -rf /var/run/encedo-wg
rm -f  /var/log/encedo-wg.log
pkgutil --forget com.encedo.wg >/dev/null 2>&1 || true
rm -f  /usr/local/bin/encedo-wg-uninstall
echo "Encedo WG removed."
