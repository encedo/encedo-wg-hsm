# Built by build.sh: a pristine upstream checkout with our four files copied
# over it. Nothing here is edited by hand — the patches live in
# _wireguard-go-encedo/ and are overlaid at build time.
/wireguard-go/

# Release binaries.
/dist/

# Editor and OS noise.
*.swp
.DS_Store
/dist-gui/

# GUI build output; the binary takes its name from the directory.
/gui/gui
/gui/gui.exe
dist-deb/
dist-gui/

# Generated into gui/ by goversioninfo during the Windows build: the icon and
# version resource Windows reads from the file itself. Regenerated every build
# from packaging/icon.ico and the stamp, so it is not worth keeping.
gui/*.syso
