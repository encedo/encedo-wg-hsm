[Desktop Entry]
Type=Application
Name=Encedo WG
GenericName=VPN client
Comment=A WireGuard tunnel whose private key never leaves the module
Exec=encedo-wg-gui
Icon=encedo-wg
Terminal=false
Categories=Network;Security;System;
Keywords=VPN;WireGuard;Encedo;HEM;

# StartupWMClass is how the desktop recognises the window as belonging to this
# entry. Without a match GNOME has an entry with an icon and a window with no
# icon, and cannot tell they are the same application: the dash shows its own
# placeholder beside a tray icon that is correct, which is exactly as unfinished
# as it looks.
#
# GLFW takes both parts of WM_CLASS from the window title when nothing sets
# them, so this has to be whatever gui/main.go calls windowTitle - today
# "Encedo WG". Changing the title changes this, and changing one without the
# other breaks the match silently: everything still runs, and only the icon in
# the dash is wrong.
StartupWMClass=Encedo WG
